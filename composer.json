{
    "name": "jeffersongoncalves/laravel-hunter",
    "description": "Hunter.io email finding, verification, domain search and lead management API for Laravel",
    "keywords": [
        "laravel",
        "laravel-hunter"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-hunter",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Sim\u00e3o Gon\u00e7alves",
            "email": "gerson.simao.92@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\Hunter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\Hunter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\Hunter\\HunterServiceProvider"
            ],
            "aliases": {
                "Hunter": "JeffersonGoncalves\\Hunter\\Facades\\Hunter"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
